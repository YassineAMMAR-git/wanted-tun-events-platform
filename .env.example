# Copy this file to .env and fill in the values.
# .env is loaded by Next.js (app) and by drizzle.config.ts (drizzle-kit).

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public URL of the app, used in links inside e-mails (account confirmation, reminders)
APP_URL=http://localhost:3000

# First administrator, created on the first start when the database is empty.
# REQUIRED in production: without these, no account is created at all (the catalogue still is)
# and the log says so. Demo accounts are never created in production.
# In development they are optional: leaving them empty keeps admin@wantedtun.tn / Admin2026!.
# Use at least 12 characters with upper/lower case, a digit and a symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail delivery via Resend (https://resend.com/api-keys).
# Leave RESEND_API_KEY empty in development to simulate sending (content printed in the terminal).
# In production an empty key makes every e-mail fail (logged as "failed").
RESEND_API_KEY=
# Sender: must use a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account address.
MAIL_FROM="WANTED TUN EVENTS <onboarding@resend.dev>"
# Optional: address receiving replies (e.g. contact@your-domain)
MAIL_REPLY_TO=
# Test: npm run email:test -- you@example.com

# Shared secret expected by GET /api/cron/reminders (header x-cron-secret or Authorization: Bearer)
CRON_SECRET=
